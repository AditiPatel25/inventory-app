<html>

<head>
    <link rel="stylesheet" href="/styles.css">
</head>

<body>
    <section class="add-instrument-header">
        <div class="categories-navbar">
            <%- include('partials/navbar') %>
        </div>
    </section>
    <section class="add-new">
        <h1>
            <%= editing ? 'Edit Category' : 'Add Category' %>
        </h1>
        <form action="<%= editing && category ? '/categories/' + category.id : '/categories' %>" method="POST">
            <input type="text" name="category_name" id="category_name"
                value="<%= editing && category ? category.category_name : '' %>">
            <div class="edit-add-btn">
                <% if (editing) { %>
                    <a href="/categories/new" class="submit-btn cancel-btn">Cancel</a>
                    <% } %>
                        <button type="submit" class="submit-btn">Submit</button>
            </div>
        </form>

    </section>
    <div class="table-card">
        <% if (typeof error !=='undefined' ) { %>
            <p class="error">
                <%= error %>
            </p>
            <% } %>
                <table>
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% categories.forEach(category=> { %>
                            <tr>
                                <td>
                                    <%= category.category_name %>
                                </td>

                                <td>
                                    <div class="actions">
                                        <a href="/categories/<%= category.id %>/edit" class="action-btn">Edit</a>
                                        <form action="/categories/<%= category.id %>/delete" method="POST">
                                            <button type="submit" class="action-btn"
                                                onclick="return confirm('Are you sure you want to delete this category?')">Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>

                            <% }) %>
                    </tbody>
                </table>
    </div>

</body>

</html>