<html>

<head>
    <link rel="stylesheet" href="/styles.css">
</head>

<body>
    <section class="categorypage-header">
        <div class="categories-navbar">
            <%- include('partials/navbar') %>
        </div>
    </section>
    <div class="filter-categories">
        <a href="/categories" class="filter-btn <%= selectedCategory === null ? 'active' : '' %>">All</a>
        <% categories.forEach(category=> { %>
            <a href="/categories/<%= category.id %>"
                class="filter-btn <%= selectedCategory === category.id ? 'active' : '' %>">
                <%= category.category_name %>
            </a>
            <% }) %>

    </div>
    <div class="table-card">
        <% if (typeof error !=='undefined' && error) { %>
            <p class="error">
                <%= error %>
            </p>
            <% } %>
                <table>
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Price</th>
                            <th>Quantity</th>
                            <th>Description</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% instruments.forEach(instrument=> { %>
                            <tr>
                                <td>
                                    <%= instrument.instrument_name %>
                                </td>
                                <td>
                                    $<%= instrument.price %>
                                </td>
                                <td>
                                    <%= instrument.quantity %>
                                </td>
                                <td>
                                    <%= instrument.description %>
                                </td>
                                <td>
                                    <div class="actions">
                                        <a href="/instruments/<%= instrument.id %>/edit" class="action-btn">Edit</a>
                                        <form action="/instruments/<%= instrument.id %>/delete" method="POST">
                                            <button type="button" class="action-btn"
                                                onclick="openModal(this.closest('form'))">Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>

                            <% }) %>
                    </tbody>
                </table>
    </div>
    <%- include('partials/adminModal') %>
</body>

</html>